/* ОСХ-Аналитик — тёмная тема (сдержанная сталь-индиго) */

* {
    color: #dce0ea;
    font-family: "IBM Plex Sans", "Inter", "Segoe UI", "DejaVu Sans", sans-serif;
    font-size: 10pt;
}

QMainWindow, QDialog, QWidget {
    background-color: #0e1117;
}

/* ============ Sidebar ============ */

QFrame#Sidebar {
    background-color: #0a0d12;
    border-right: 1px solid #1b1f2a;
}

QLabel#SidebarBrand {
    color: #ffffff;
    font-size: 15pt;
    font-weight: 600;
    padding: 20px 22px 2px 22px;
}

QLabel#SidebarSubtitle {
    color: #6c7689;
    font-size: 8pt;
    padding: 0 22px 16px 22px;
    letter-spacing: 0.4px;
}

QLabel#SectionHeader {
    color: #5a6478;
    font-size: 7.5pt;
    font-weight: 600;
    padding: 14px 24px 4px 24px;
    letter-spacing: 1.4px;
    text-transform: uppercase;
}

QPushButton#NavButton {
    background-color: transparent;
    color: #b4bbcc;
    text-align: left;
    padding: 9px 20px 9px 21px;
    border: none;
    border-left: 3px solid transparent;
    font-size: 10pt;
}

QPushButton#NavButton:hover {
    background-color: #131722;
    color: #ffffff;
}

QPushButton#NavButton:checked {
    background-color: #141927;
    color: #ffffff;
    border-left: 3px solid transparent;
    font-weight: 500;
}

QPushButton#NavButton:disabled {
    color: #4a526a;
    background-color: transparent;
    border-left: 3px solid transparent;
}

QLabel#SidebarFooter {
    color: #4a526a;
    font-size: 8pt;
    padding: 12px 22px;
}

/* ============ Page header ============ */

QWidget#PageHeader {
    background: transparent;
}

QLabel#PageTitle {
    font-size: 17pt;
    font-weight: 600;
    color: #ffffff;
}

QLabel#PageSubtitle {
    font-size: 9.5pt;
    color: #8a93a6;
}

QToolButton#InfoButton {
    background-color: transparent;
    border: 1px solid #2a2f3d;
    color: #8a93a6;
    border-radius: 11px;
    min-width: 22px;
    max-width: 22px;
    min-height: 22px;
    max-height: 22px;
    font-size: 9pt;
    font-weight: 600;
    padding: 0;
}
QToolButton#InfoButton:hover, QToolButton#InfoButton:checked {
    color: #ffffff;
    border-color: #7c8ab0;
    background-color: #131722;
}

QFrame#InfoPopover {
    background-color: #141823;
    border: 1px solid #262b39;
    border-radius: 8px;
}
QFrame#InfoPopover QLabel { color: #dce0ea; font-size: 9.5pt; }
QFrame#InfoPopover QLabel#InfoPopoverTitle {
    color: #98a8c8; font-weight: 600; font-size: 9pt;
    text-transform: uppercase; letter-spacing: 0.8px;
}

/* ============ Cards ============ */

QFrame#Card {
    background-color: #141823;
    border: 1px solid #1f2330;
    border-radius: 10px;
}

QLabel#CardTitle {
    font-size: 8.5pt;
    color: #7a8398;
    font-weight: 600;
    letter-spacing: 1px;
    text-transform: uppercase;
    padding: 14px 16px 0 16px;
}

QLabel#CardValue {
    font-size: 19pt;
    font-weight: 600;
    color: #ffffff;
    padding: 4px 16px 2px 16px;
}

QLabel#CardCaption {
    font-size: 9pt;
    color: #8a93a6;
    padding: 0 16px 12px 16px;
}

/* ============ Buttons ============ */

QPushButton {
    background-color: #1a1f2b;
    color: #dce0ea;
    border: 1px solid #262b39;
    border-radius: 6px;
    padding: 7px 14px;
    min-height: 16px;
}

QPushButton:hover { background-color: #20263a; border-color: #2e3447; }
QPushButton:pressed { background-color: #262b39; }
QPushButton:disabled { color: #4a526a; background-color: #11141c; border-color: #1b1f2a; }

QPushButton#Primary {
    background-color: #7c8ab0;
    color: #0a0d12;
    border: 1px solid #7c8ab0;
    font-weight: 600;
}
QPushButton#Primary:hover { background-color: #98a8c8; border-color: #98a8c8; }
QPushButton#Primary:pressed { background-color: #6a7799; border-color: #6a7799; }
QPushButton#Primary:disabled {
    background-color: #2a2f3d;
    color: #6c7689;
    border-color: #2a2f3d;
}

QPushButton#HintBadge {
    background-color: transparent;
    border: 1px solid #2a2f3d;
    color: #8a93a6;
    border-radius: 9px;
    padding: 0;
    min-width: 18px;
    max-width: 18px;
    min-height: 18px;
    max-height: 18px;
    font-size: 9pt;
    font-weight: 600;
}
QPushButton#HintBadge:hover {
    color: #ffffff;
    border-color: #7c8ab0;
}

QPushButton#SectionToggle {
    background: transparent;
    color: #b4bbcc;
    border: none;
    text-align: left;
    padding: 6px 4px;
    font-weight: 600;
    font-size: 9pt;
    letter-spacing: 0.4px;
}
QPushButton#SectionToggle:hover { color: #ffffff; }

/* ============ Inputs ============ */

QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox {
    background-color: #161a25;
    border: 1px solid #262b39;
    border-radius: 6px;
    padding: 6px 8px;
    color: #dce0ea;
    selection-background-color: #7c8ab0;
    selection-color: #0a0d12;
    min-height: 18px;
}
QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus {
    border: 1px solid #7c8ab0;
}

QComboBox::drop-down { border: 0; width: 18px; }
QComboBox QAbstractItemView {
    background-color: #141823; color: #dce0ea;
    selection-background-color: #2a3450; border: 1px solid #262b39;
    outline: 0;
    padding: 2px;
}

QSpinBox::up-button, QSpinBox::down-button,
QDoubleSpinBox::up-button, QDoubleSpinBox::down-button {
    background: #1a1f2b; border: none; width: 14px;
}
QSpinBox::up-arrow, QDoubleSpinBox::up-arrow { width: 7px; height: 7px; }
QSpinBox::down-arrow, QDoubleSpinBox::down-arrow { width: 7px; height: 7px; }

/* ============ Tables ============ */

QTableView, QTableWidget {
    background-color: #0f1219;
    gridline-color: #1f2330;
    color: #dce0ea;
    border: 1px solid #1f2330;
    border-radius: 6px;
    selection-background-color: #2a3450;
    selection-color: #ffffff;
    alternate-background-color: #131722;
    outline: 0;
}

QTableView::item {
    padding: 4px 8px;
    border: 0;
}
QTableView::item:selected { background-color: #2a3450; color: #ffffff; }

QHeaderView { background-color: #141823; border: 0; }
QHeaderView::section {
    background-color: #141823;
    color: #8a93a6;
    padding: 7px 10px;
    border: 0;
    border-right: 1px solid #1f2330;
    border-bottom: 1px solid #1f2330;
    font-weight: 600;
    font-size: 9pt;
}
QHeaderView::section:vertical {
    border-right: 1px solid #1f2330;
}

QTableCornerButton::section {
    background-color: #141823;
    border: 0;
    border-right: 1px solid #1f2330;
    border-bottom: 1px solid #1f2330;
}

/* ============ Scrollbars ============ */

QScrollBar:vertical, QScrollBar:horizontal {
    background: transparent; border: none; margin: 0; width: 10px; height: 10px;
}
QScrollBar::handle:vertical, QScrollBar::handle:horizontal {
    background: #262b39; border-radius: 5px; min-height: 24px; min-width: 24px;
}
QScrollBar::handle:hover { background: #3a4257; }
QScrollBar::add-line, QScrollBar::sub-line {
    background: transparent; border: none; height: 0; width: 0;
}
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }
QAbstractScrollArea::corner { background: #0f1219; border: 0; }

/* ============ Tabs ============ */

QTabWidget::pane {
    border: 1px solid #1f2330;
    border-radius: 8px;
    top: -1px;
    background: #11141c;
}
QTabBar { qproperty-drawBase: 0; }
QTabBar::tab {
    background: transparent;
    color: #8a93a6;
    padding: 8px 18px;
    border: 1px solid transparent;
    border-bottom: none;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    margin-right: 2px;
    font-size: 9.5pt;
}
QTabBar::tab:hover { color: #dce0ea; }
QTabBar::tab:selected {
    background: #141823;
    color: #ffffff;
    border: 1px solid #1f2330;
    border-bottom: 1px solid #141823;
}
QTabBar::tab:disabled { color: #4a526a; }

/* ============ Dock widgets ============ */

QDockWidget {
    color: #dce0ea;
    titlebar-close-icon: url(none);
    titlebar-normal-icon: url(none);
}

QDockWidget::title {
    background: #0d1018;
    padding: 8px 14px;
    border-bottom: 1px solid #1b1f2a;
    color: #98a8c8;
    font-size: 8.5pt;
    font-weight: 600;
    letter-spacing: 1.2px;
    text-transform: uppercase;
}

QDockWidget > QWidget { background: #0e1117; }

QDockWidget::close-button, QDockWidget::float-button {
    background: transparent;
    border: 0;
    icon-size: 12px;
    padding: 2px;
}
QDockWidget::close-button:hover, QDockWidget::float-button:hover {
    background: #1a1f2b;
    border-radius: 3px;
}

/* ============ Status & tooltips ============ */

QStatusBar {
    background-color: #0a0d12;
    color: #8a93a6;
    border-top: 1px solid #1b1f2a;
    padding: 2px 8px;
}
QStatusBar QLabel { color: #8a93a6; }

QToolTip {
    background-color: #141823;
    color: #dce0ea;
    border: 1px solid #2a2f3d;
    padding: 6px 9px;
    border-radius: 4px;
}

/* ============ Groupboxes ============ */

QGroupBox {
    border: 1px solid #1f2330;
    border-radius: 8px;
    margin-top: 14px;
    padding: 12px 12px 10px 12px;
    color: #b4bbcc;
    font-weight: 500;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 8px;
    color: #8a93a6;
    font-size: 8.5pt;
    letter-spacing: 0.6px;
    text-transform: uppercase;
}

/* ============ Check / radio ============ */

QCheckBox, QRadioButton { color: #dce0ea; spacing: 6px; }
QCheckBox::indicator, QRadioButton::indicator { width: 16px; height: 16px; }
QCheckBox::indicator:unchecked, QRadioButton::indicator:unchecked {
    background: #11141c; border: 1px solid #2a2f3d; border-radius: 3px;
}
QCheckBox::indicator:checked {
    background: #7c8ab0; border: 1px solid #7c8ab0; border-radius: 3px;
}
QRadioButton::indicator { border-radius: 8px; }
QRadioButton::indicator:checked { background: #7c8ab0; border: 1px solid #7c8ab0; }

/* ============ Progress ============ */

QProgressBar {
    background: #11141c; border: 1px solid #1f2330; border-radius: 6px;
    text-align: center; color: #dce0ea;
}
QProgressBar::chunk { background-color: #7c8ab0; border-radius: 6px; }

/* ============ Splitters ============ */

QSplitter::handle { background: #1b1f2a; }
QSplitter::handle:hover { background: #2a3450; }
QSplitter::handle:horizontal { width: 5px; }
QSplitter::handle:vertical { height: 5px; }

/* ============ Result summary (inline interpretation) ============ */

QLabel#ResultSummary {
    color: #b4bbcc;
    padding: 8px 12px;
    background-color: #131722;
    border: 1px solid #1f2330;
    border-radius: 6px;
}
